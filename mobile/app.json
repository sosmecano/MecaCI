{
  "expo": {
    "name": "Mecanova",
    "slug": "mecanova",
    "owner": "mecanova",
    "scheme": "mecanova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mecanova.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mecanova utilise votre position pour trouver des mécaniciens et garages à proximité.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Mecanova suit votre position en arrière-plan pour partager votre localisation avec le professionnel pendant une mission.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mecanova.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "31544247-cabb-4ded-94c6-5c5ebb1be985"
      }
    }
  }
}
